        Предоставляет полный набор операций CRUD (создание, чтение, обновление, удаление)
        для модели Course.
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this Курс.
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Course'
          description: ''
    put:
      operationId: api_materials_courses_update
      description: |-
        ViewSet для управления курсами.
