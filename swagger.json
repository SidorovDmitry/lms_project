      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/materials/subscribe/:
    post:
      operationId: api_materials_subscribe_create
      description: Добавляет или удаляет подписку пользователя на указанный курс
      summary: Управление подпиской на курс
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                course_id:
                  type: integer
                  description: ID курса для подписки/отписки
                  example: 1
              required:
              - course_id
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                properties:
                  message:
                    type: string
                    description: Сообщение о результате операции
                    examples:
                    - подписка добавлена
                    - подписка удалена
              examples:
                ПримерУспешнойПодписки:
                  value:
                    message: подписка добавлена
                  summary: Пример успешной подписки
                ПримерУспешнойОтписки:
                  value:
                    message: подписка удалена
                  summary: Пример успешной отписки
          description: ''
        '400':
          content:
            application/json:
              schema:
                type: object
                properties:
                  error:
                    type: string
                    description: Сообщение об ошибке
                    examples:
                    - Не указан course_id
                    - Курс не найден
              examples:
                ПримерОшибки:
                  value:
                    error: Курс не найден
                  summary: Пример ошибки
          description: ''
  /api/payments/course/{course_id}/:
    post:
      operationId: api_payments_course_create
      description: Создает продукт, цену и сессию оплаты Stripe для указанного курса.
        Возвращает URL для оплаты и ID сессии.
      summary: Создание платежной сессии Stripe для курса
      parameters:
      - in: path
        name: course_id
        schema:
          type: integer
        description: ID курса, для которого создается платежная сессия.
        required: true
      tags:
      - api
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                type: object
                properties:
                  payment_url:
                    type: string
                    description: URL для оплаты в Stripe.
                  session_id:
                    type: string
                    description: ID сессии Stripe.
                  amount:
                    type: integer
                    description: Сумма к оплате (в центах).
                  course:
                    type: string
                    description: Название курса.
                example:
                  payment_url: https://checkout.stripe.com/...
                  session_id: cs_test_...
                  amount: 10000
                  course: Название курса
          description: ''
        '404':
          content:
            application/json:
              schema:
                type: object
                properties:
                  error:
                    type: string
                    example: Курс не найден
          description: ''
  /api/payments/payments/:
    get:
      operationId: api_payments_payments_list
      description: |-
        API эндпоинт для управления платежами.
        Поддерживает:
        - Фильтрацию по курсу, уроку и способу оплаты
        - Сортировку по дате оплаты
        - Разграничение прав: только администратор может редактировать данные
      parameters:
      - in: query
        name: course
        schema:
          type: integer
        description: ID курса
      - in: query
        name: lesson
        schema:
          type: integer
        description: ID урока
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - in: query
        name: payment_method
        schema:
          type: string
          title: Способ оплаты
          enum:
          - CASH
          - TRANSFER
        description: |-
          Способ оплаты

          * `CASH` - Наличные
          * `TRANSFER` - Перевод на счёт
      tags:
      - api
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Payment'
          description: ''
    post:
      operationId: api_payments_payments_create
      description: |-
        API эндпоинт для управления платежами.
        Поддерживает:
        - Фильтрацию по курсу, уроку и способу оплаты
        - Сортировку по дате оплаты
        - Разграничение прав: только администратор может редактировать данные
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Payment'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Payment'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Payment'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'
          description: ''
