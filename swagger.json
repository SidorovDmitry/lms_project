components:
  schemas:
    Course:
      type: object
      description: Сериализатор для модели Course.
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          title: Название курса
          maxLength: 255
        description:
          type: string
          nullable: true
          title: Описание курса
        preview:
          type: string
          format: uri
          nullable: true
          title: Превью курса
        owner:
          type: integer
          readOnly: true
          nullable: true
          title: Владелец курса
        lessons:
          type: array
          items:
            $ref: '#/components/schemas/Lesson'
          readOnly: true
        stripe_price_id:
          type: string
          readOnly: true
        stripe_product_id:
          type: string
          readOnly: true
      required:
      - id
      - lessons
      - owner
      - stripe_price_id
      - stripe_product_id
      - title
    Lesson:
      type: object
      description: |-
        Сериализатор для модели Lesson.
        Предоставляет данные об отдельном уроке, включая его связь с курсом.
        Поле 'course' содержит ID связанного курса (только для чтения по умолчанию).
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          title: Название урока
          maxLength: 255
        description:
          type: string
          nullable: true
          title: Описание урока
        preview:
          type: string
          format: uri
          nullable: true
          title: Превью урока
        video_url:
          type: string
          format: uri
        course:
          type: integer
          title: Курс
      required:
      - course
      - id
      - title
      - video_url
    MyTokenObtainPair:
      type: object
      properties:
        email:
          type: string
          writeOnly: true
        password:
          type: string
          writeOnly: true
      required:
      - email
      - password
    PatchedCourse:
      type: object
      description: Сериализатор для модели Course.
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          title: Название курса
          maxLength: 255
        description:
          type: string
          nullable: true
          title: Описание курса
        preview:
          type: string
          format: uri
          nullable: true
          title: Превью курса
        owner:
          type: integer
          readOnly: true
          nullable: true
          title: Владелец курса
        lessons:
          type: array
          items:
            $ref: '#/components/schemas/Lesson'
          readOnly: true
        stripe_price_id:
          type: string
          readOnly: true
        stripe_product_id:
          type: string
          readOnly: true
    PatchedLesson:
      type: object
      description: |-
        Сериализатор для модели Lesson.
        Предоставляет данные об отдельном уроке, включая его связь с курсом.
        Поле 'course' содержит ID связанного курса (только для чтения по умолчанию).
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          title: Название урока
          maxLength: 255
        description:
          type: string
          nullable: true
          title: Описание урока
        preview:
          type: string
          format: uri
          nullable: true
          title: Превью урока
        video_url:
          type: string
          format: uri
        course:
          type: integer
          title: Курс
    PatchedPayment:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        payment_date:
